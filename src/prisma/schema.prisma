generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(255)
  address   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]
  storeStocks StoreStock[]
  stockOpnames StockOpname[]

  @@map("stores")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  nik       String   @unique @db.VarChar(50)
  username  String   @unique @db.VarChar(50)
  password  String   @db.VarChar(255)
  name      String   @db.VarChar(255)
  storeId   String?  @map("store_id") @db.Uuid
  role      Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store? @relation(fields: [storeId], references: [id], onDelete: Restrict)
  initiatedOpnames StockOpname[] @relation("OpnameInitiator")
  submittedOpnames StockOpname[] @relation("OpnameSubmitter")
  approvedOpnames  StockOpname[] @relation("OpnameApprover")

  @@index([storeId])
  @@map("users")
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  sku       String   @unique @db.VarChar(50)
  name      String   @db.VarChar(255)
  price     Decimal  @db.Decimal(15, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  storeStocks StoreStock[]
  stockOpnameItems StockOpnameItem[]

  @@map("products")
}

model StoreStock {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([storeId, productId])
  @@index([productId])
  @@map("store_stock")
}

model StockOpname {
  id          String    @id @default(uuid()) @db.Uuid
  storeId     String    @map("store_id") @db.Uuid
  scope       Int       @db.SmallInt
  status      Int       @default(0) @db.SmallInt
  note        String?   @db.Text
  initiatedBy String    @map("initiated_by") @db.Uuid
  submittedBy String?   @map("submitted_by") @db.Uuid
  approvedBy  String?   @map("approved_by") @db.Uuid
  initiatedAt DateTime  @default(now()) @map("initiated_at")
  submittedAt DateTime? @map("submitted_at")
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  store     Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  initiator User   @relation("OpnameInitiator", fields: [initiatedBy], references: [id], onDelete: Restrict)
  submitter User?  @relation("OpnameSubmitter", fields: [submittedBy], references: [id], onDelete: Restrict)
  approver  User?  @relation("OpnameApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  items     StockOpnameItem[]

  @@index([storeId, status])
  @@map("stock_opnames")
}

model StockOpnameItem {
  id            String   @id @default(uuid()) @db.Uuid
  stockOpnameId String   @map("stock_opname_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  systemQty     Int      @map("system_qty")
  countedQty    Int?     @map("counted_qty")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  stockOpname StockOpname @relation(fields: [stockOpnameId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([stockOpnameId, productId])
  @@index([productId])
  @@map("stock_opname_items")
}